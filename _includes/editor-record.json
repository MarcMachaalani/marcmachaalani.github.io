{"path":{{ p.path | jsonify }},"url":{{ p.url | jsonify }},"title":{{ p.title | strip_html | jsonify }},"fields":{ {% for field in editor_fields %}{{ field | jsonify }}:{% if field == 'topics' %}{{ p.topics | join: ', ' | jsonify }}{% else %}{% assign field_value = p[field] | default: '' %}{% if field == 'date' and p.date %}{{ p.date | date: '%Y-%m-%d' | jsonify }}{% else %}{{ field_value | jsonify }}{% endif %}{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %}},"body":{{ p.content | jsonify }},"media":{"gallery":{{ p.gallery | default: empty_gallery | jsonify }}}}